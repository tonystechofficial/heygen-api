# HeyGen API
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_API_URL=https://api.heygen.com

# Database
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=heygen_api
DB_USER=heygen
DB_PASSWORD=heygen_password
DB_ROOT_PASSWORD=rootpassword

# Application
APP_URL=http://localhost
APP_DEBUG=true

# Webhook (optional - for HeyGen callbacks)
WEBHOOK_SECRET=your_webhook_secret_here

